    ],
    "main_plan": "Develop a broad character board, convert exerted bodies into Elinor value, and protect profitable quests with bodyguards, bounce and Shift.",
    "packages": [
      {
        "role": "early development",
        "cards": [
          "Aurora - Holding Court",
          "Bobby Zimuruski - Spray Cheese Kid",
          "Thomas - Wide-Eyed Recruit",
          "The Queen - Regal Monarch"
        ],
        "purpose": "Cheap bodies supply pressure and opportunities to build the three-exerted-character condition."
      },
      {
        "role": "cost savings",
        "cards": [
          "Pluto - Friendly Pooch",
          "Grandmother Willow - Ancient Advisor",
          "Aurora - Holding Court"
        ],
        "purpose": "Discounts improve deployment but do not add permanent ink; protect enough inkable cards."
      },
      {
        "role": "character access",
        "cards": [
          "Mike Wazowski - Heroic Climber",
          "Nani - Stage Manager",
          "Pocahontas - Guiding the Tribe"
        ],
        "purpose": "An all-character deck improves Mike reveals; Nani and Pocahontas reward cheap-character density."
      },
      {
        "role": "engine and protection",
        "cards": [
          "Elinor - Renowned Diplomat",
          "Dale - Ready for His Shot",
          "David - Protective Snowboarder",
          "Pocahontas - Peacekeeper"
        ],
        "purpose": "Elinor rewards exerting; Dale uses current willpower for challenge damage; shifted Peacekeeper conditionally prevents challenges."
      },
      {
        "role": "interaction",
        "cards": [
          "Ursula - Deceiver",
          "Rapunzel - Tower Defender"
        ],
        "purpose": "Disrupt songs or bounce a chosen character; discarding for Rapunzel has a resource cost."
      }
